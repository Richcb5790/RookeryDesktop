{
  "name": "rookery-site",
  "version": "0.1.0",
  "description": "The website for Rookery, a visual Git client with branch lineage and submodule sync",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@fontsource/poppins": "5.3.0",
    "gsap": "3.15.0",
    "lenis": "1.3.27"
  },
  "devDependencies": {
    "simple-icons": "16.35.0",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
